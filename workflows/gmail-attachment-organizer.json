        "jsCode": "const item = $input.first();\nconst output = [];\n\nfor (const [key, attachment] of Object.entries(item.binary)) {\n  output.push({\n    json: {\n      attachmentKey: key,\n      mimeType: attachment.mimeType,\n      fileName: attachment.fileName || attachment.fileName,\n    },\n    binary: {\n      data: attachment,\n    },\n  });\n}\n\nreturn output;"
      },
